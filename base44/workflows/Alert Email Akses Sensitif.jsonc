{
  "name": "Alert Email Akses Sensitif",
  "description": "Kirim email notifikasi ke admin setiap kali ada akses ke data sensitif (sensitive_access log)",
  "trigger": {
    "condition": "${ (.trigger.data.log_type == \"sensitive_access\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "SystemLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_email_akses_sensitif",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alertSensitiveAccess",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "alertSensitiveAccess"
  }
}