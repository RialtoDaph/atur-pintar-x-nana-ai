{
  "name": "Complete Mission - Tanya Nana",
  "description": "Mark tanya_nana daily mission as completed when user sends a message to Nana",
  "trigger": {
    "condition": "${ (.trigger.data.role == \"user\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "NanaConversation"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "complete_mission_tanya_nana",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "completeDailyMission",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "completeDailyMission"
  }
}