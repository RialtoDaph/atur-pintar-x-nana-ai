{
  "name": "FeedbackReport response notifier",
  "description": "Email user saat admin membalas atau mengubah status FeedbackReport mereka.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"admin_response\") != null) or (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FeedbackReport"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "feedbackreport_response_notifier",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendFeedbackResponseEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendFeedbackResponseEmail"
  }
}